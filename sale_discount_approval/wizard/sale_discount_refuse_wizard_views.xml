<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_discount_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.discount.refuse.wizard.form</field>
        <field name="model">sale.discount.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuser la remise">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Pourquoi cette remise est-elle refusée ?"/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuser la remise" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
