<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_discount_approval" model="res.groups.privilege">
        <field name="name">Validation des remises</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_discount_approver" model="res.groups">
        <field name="name">Valideur de remises</field>
        <field name="privilege_id" ref="res_groups_privilege_discount_approval"/>
        <field name="comment">Peut valider ou refuser les remises qui dépassent le seuil de la société.</field>
        <!-- Pour valider, il faut voir tous les devis, pas seulement les siens. -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <!-- Les responsables des ventes valident les remises,
         comme le responsable des achats approuve les achats. -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_discount_approver'))]"/>
    </record>
</odoo>
